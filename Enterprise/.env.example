# Secrets below are placeholders ONLY. deploy.sh auto-generates real random
# values when it creates .env (and auto-regenerates these if left untouched).
# The API also auto-generates + persists its own token if API_TOKEN is missing.
POSTGRES_DB=ittoolkit
POSTGRES_USER=ittoolkit
POSTGRES_PASSWORD=change-me-strong
API_TOKEN=change-me-random-token
# SERVER_HOST is auto-detected by deploy.sh (LAN/Public IP or domain).
# Override here to pin a domain/FQDN instead.
SERVER_HOST=auto
# How the Windows agent installer gets built (set by deploy scripts; also the
# wizard's default): local_windows (built on a Windows Server) | github
# (remote GitHub Actions build) | manual (you upload the MSI).
BUILD_MODE=manual
# Optional: force a TLS certificate domain for Caddy. Leave empty for IP + self-signed.
CADDY_HOST=
# Optional: SMTP for alert emails (P6.1). Emails are only sent when SMTP_HOST
# is set. These env vars are the fallback; you can instead configure email
# interactively on the first-run setup page (provider presets: Hostinger,
# Office 365, Gmail, Hotmail/Outlook, or custom host/port/encryption).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=it-tool@aaditechs.in
# SMTP_PASSWORD=change-me
# SMTP_FROM=it-tool@aaditechs.in
# SMTP_TO=it-tool@aaditechs.in
# SMTP_ENCRYPTION=ssl   # starttls | ssl | none
# How often the alert eval loop runs (minutes).
ALERT_EVAL_MINUTES=1
